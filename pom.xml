<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- The parent of the per-Spark-minor artifacts (Phase 1 plan, step B1; spec 2, "Build"). It builds nothing itself:
	     each module under spark-4.<n>/ compiles the shared src/main/scala and src/test/scala, plus its overlay
	     src/spark-4.<n>/scala, against its own Spark line. See .claude/skills/new-spark-line/SKILL.md to add one. -->
	<groupId>com.redis</groupId>
	<artifactId>spark-redis-parent_2.13</artifactId>
	<version>4.0.0-M1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>Spark-Redis</name>
	<description>A Spark library for Redis</description>
	<url>http://github.com/RedisLabs/spark-redis</url>

	<organization>
		<name>RedisLabs</name>
		<url>www.redislabs.com</url>
	</organization>
	<issueManagement>
		<url>https://github.com/RedisLabs/spark-redis/issues</url>
		<system>Github</system>
	</issueManagement>
	<scm>
		<url>https://github.com/RedisLabs/spark-redis</url>
		<connection>scm:git:git://github.com/RedisLabs/spark-redis.git</connection>
		<developerConnection>scm:git:git@github.com:RedisLabs/spark-redis.git</developerConnection>
	</scm>
	<developers>
		<developer>
			<name>Sun He</name>
			<organization>Redis Labs, Inc.</organization>
		</developer>
		<developer>
			<name>Shay Nativ</name>
			<organization>Redis Labs, Inc.</organization>
		</developer>
	</developers>
	<licenses>
		<license>
			<name>BSD 3 Clause</name>
			<url>https://opensource.org/licenses/BSD-3-Clause</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<!-- One module per supported Spark minor, as versions.yml lists them. Each sets spark.version, the Scala version
	     that Spark release is built with, and spark.line (the overlay's directory name). -->
	<modules>
		<module>spark-4.1</module>
		<module>spark-4.2</module>
		<module>spark-4.3</module>
	</modules>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<!-- The repository root, where the shared sources, test resources and configs are. Every module is one
		     directory below it, and its test JVM runs there, because the tests read fixtures by relative paths
		     (src/test/resources/golden, .../legacy, .../tls) and write under target/. -->
		<redis.root>${project.basedir}/..</redis.root>
		<!-- Spark 4 needs JDK 17 or later. javac and scalac both compile with release 17 (Phase 1 plan, step A1). -->
		<java.version>17</java.version>
		<!-- Spark 4 is built for Scala 2.13 only. Each module sets scala.complete.version to the Scala version its
		     spark.version is built with, read from <scala.version> in spark-parent_2.13-<spark.version>.pom. -->
		<scala.major.version>2.13</scala.major.version>
		<!-- The floor's versions, which every module overrides. The parent needs them only to resolve its own
		     <dependencies> list. -->
		<spark.version>4.1.4</spark.version>
		<scala.complete.version>2.13.17</scala.complete.version>
		<jedis.version>3.9.0</jedis.version>
		<!-- 2.0.0 or later: the plugin starts the test JVM from ${java.home}, the JDK that runs Maven (JAVA_HOME).
		     1.0 ran whatever `java` came first on PATH, so a jenv or Homebrew JDK 17 there broke the tests. -->
		<plugins.scalatest.version>2.2.0</plugins.scalatest.version>
		<testcontainers.version>1.21.4</testcontainers.version>
		<!-- Test Redis: the image RedisContainers runs, and whether it runs containers at all. Override on the
		     command line, for example -Dredis.image=redis:8.6. Forwarded to the test JVM below. -->
		<redis.image>redis:8.2</redis.image>
		<redis.containers>true</redis.containers>
		<!-- Set to true (-Dgolden.update=true) to regenerate golden fixtures. Only the owner does that. -->
		<golden.update>false</golden.update>
		<!-- The JVM options Spark 4 needs on JDK 17+: the module options spark-submit adds itself, copied from
		     org.apache.spark.launcher.JavaModuleOptions in spark-launcher 4.1.4. The test JVM gets them below.
		     Spark 4.2 and 4.3 drop jdk.reflect.useDirectMethodHandle=false and add the sun-misc-unsafe-memory-access=allow
		     option, which is for JDK 23 and later; neither matters on JDK 17 or 21, the JDKs the connector supports. -->
		<spark.test.jvm.options>-XX:+IgnoreUnrecognizedVMOptions --add-modules=jdk.incubator.vector --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.net=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.util.concurrent=ALL-UNNAMED --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED --add-opens=java.base/jdk.internal.ref=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/sun.nio.cs=ALL-UNNAMED --add-opens=java.base/sun.security.action=ALL-UNNAMED --add-opens=java.base/sun.util.calendar=ALL-UNNAMED --add-opens=java.security.jgss/sun.security.krb5=ALL-UNNAMED -Djdk.reflect.useDirectMethodHandle=false -Dio.netty.tryReflectionSetAccessible=true -Dio.netty.allocator.type=pooled -Dio.netty.handler.ssl.defaultEndpointVerificationAlgorithm=NONE --enable-native-access=ALL-UNNAMED</spark.test.jvm.options>
		<spark.test.ssl.options>-Djavax.net.ssl.trustStorePassword=password -Djavax.net.ssl.trustStore=./src/test/resources/tls/clientkeystore -Djavax.net.ssl.trustStoreType=jceks</spark.test.ssl.options>
	</properties>

	<!-- GitHub Packages in the spike's fork (Phase 0 plan, step C9). OSSRH has been shut down (spec 2.13).
	     .github/workflows/publish-snapshot.yml deploys here with the workflow's GITHUB_TOKEN. -->
	<distributionManagement>
		<snapshotRepository>
			<id>github</id>
			<name>GitHub Packages</name>
			<url>https://maven.pkg.github.com/Redislabs-Solution-Architects/spark-redis</url>
		</snapshotRepository>
		<repository>
			<id>github</id>
			<name>GitHub Packages</name>
			<url>https://maven.pkg.github.com/Redislabs-Solution-Architects/spark-redis</url>
		</repository>
	</distributionManagement>

	<build>
		<!-- Configured here and listed in each module's <plugins>, so that this parent, which has no sources, runs none
		     of them. -->
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<!-- 0.8.7 or later reads Java 17 class files -->
					<version>0.8.16</version>
					<executions>
						<execution>
							<goals>
								<goal>prepare-agent</goal>
							</goals>
							<configuration>
								<!-- scalatest-maven-plugin sets its own argLine, which would replace the default
								     'argLine' property; expose the agent under its own name and reference it there -->
								<propertyName>jacocoArgLine</propertyName>
							</configuration>
						</execution>
						<execution>
							<id>report</id>
							<!-- must run after scalatest (bound to 'test') has written target/jacoco.exec -->
							<phase>verify</phase>
							<goals>
								<goal>report</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>net.alchim31.maven</groupId>
					<artifactId>scala-maven-plugin</artifactId>
					<version>4.10.0</version>
					<configuration>
						<scalaVersion>${scala.complete.version}</scalaVersion>
						<!-- passes -release to scalac and release to javac -->
						<release>${java.version}</release>
					</configuration>
					<executions>
						<execution>
							<id>scala-compile</id>
							<phase>process-resources</phase>
							<goals>
								<goal>compile</goal>
							</goals>
						</execution>
						<execution>
							<id>scala-test-compile</id>
							<phase>process-test-resources</phase>
							<goals>
								<goal>testCompile</goal>
							</goals>
						</execution>
						<execution>
							<id>attach-javadocs</id>
								<goals>
									<goal>doc-jar</goal>
								</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.scalastyle</groupId>
					<artifactId>scalastyle-maven-plugin</artifactId>
					<version>0.7.0</version>
					<configuration>
						<verbose>false</verbose>
						<failOnWarning>false</failOnWarning>
						<failOnViolation>true</failOnViolation>
						<includeTestSourceDirectory>true</includeTestSourceDirectory>
						<sourceDirectory>${redis.root}/src/main/scala</sourceDirectory>
						<testSourceDirectory>${redis.root}/src/test/scala</testSourceDirectory>
						<configLocation>${redis.root}/scalastyle-config.xml</configLocation>
						<outputFile>${project.build.directory}/scalastyle-output.xml</outputFile>
						<outputEncoding>UTF-8</outputEncoding>
					</configuration>
					<executions>
						<execution>
							<phase>compile</phase>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>2.6</version>
					<configuration>
						<skipIfEmpty>true</skipIfEmpty>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-assembly-plugin</artifactId>
					<version>2.5.4</version>
					<configuration>
						<descriptorRefs>
							<descriptorRef>jar-with-dependencies</descriptorRef>
						</descriptorRefs>
					</configuration>
					<executions>
						<execution>
							<phase>package</phase>
							<goals>
								<goal>single</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>build-helper-maven-plugin</artifactId>
					<version>1.10</version>
					<executions>
						<execution>
							<id>add-scala-sources</id>
							<phase>generate-sources</phase>
							<goals>
								<goal>add-source</goal>
							</goals>
							<configuration>
								<sources>
									<source>${redis.root}/src/main/scala</source>
									<!-- this Spark line's overlay: code that only compiles against it -->
									<source>${redis.root}/src/${spark.line}/scala</source>
								</sources>
							</configuration>
						</execution>
						<execution>
							<id>add-resources</id>
							<phase>generate-resources</phase>
							<goals>
								<goal>add-resource</goal>
							</goals>
							<configuration>
								<resources>
									<resource>
										<directory>${redis.root}/src/main/resources</directory>
									</resource>
								</resources>
							</configuration>
						</execution>
						<execution>
							<id>add-scala-test-sources</id>
							<phase>generate-test-sources</phase>
							<goals>
								<goal>add-test-source</goal>
							</goals>
							<configuration>
								<sources>
									<source>${redis.root}/src/test/scala</source>
								</sources>
							</configuration>
						</execution>
						<execution>
							<id>add-test-resources</id>
							<phase>generate-test-resources</phase>
							<goals>
								<goal>add-test-resource</goal>
							</goals>
							<configuration>
								<resources>
									<resource>
										<directory>${redis.root}/src/test/resources</directory>
									</resource>
								</resources>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<!-- The sources jar, published with each artifact and attached to its GitHub Release (spec 2.13). -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>3.4.0</version>
					<executions>
						<execution>
							<id>attach-sources</id>
							<goals>
								<goal>jar-no-fork</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<!-- A CycloneDX SBOM of what each artifact ships (spec 2.13): target/bom.json, attached with the cyclonedx
				     classifier, so it is deployed with the jars. Spark's provided dependencies and test dependencies stay
				     out of it. -->
				<plugin>
					<groupId>org.cyclonedx</groupId>
					<artifactId>cyclonedx-maven-plugin</artifactId>
					<version>2.9.3</version>
					<configuration>
						<outputFormat>json</outputFormat>
						<outputName>bom</outputName>
						<includeProvidedScope>false</includeProvidedScope>
						<includeTestScope>false</includeTestScope>
					</configuration>
					<executions>
						<execution>
							<phase>package</phase>
							<goals>
								<goal>makeBom</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<!-- disable surefire -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>2.18.1</version>
					<configuration>
						<skipTests>true</skipTests>
					</configuration>
				</plugin>
				<!-- enable scalatest -->
				<plugin>
					<groupId>org.scalatest</groupId>
					<artifactId>scalatest-maven-plugin</artifactId>
					<version>${plugins.scalatest.version}</version>
					<configuration>
						<!-- the repository root: see redis.root above -->
						<workingDirectory>${redis.root}</workingDirectory>
						<reportsDirectory>${project.build.directory}/surefire-reports</reportsDirectory>
						<junitxml>.</junitxml>
						<filereports>WDF TestSuite.txt</filereports>
						<argLine>${jacocoArgLine} ${spark.test.jvm.options} -Xmx2g ${spark.test.ssl.options}</argLine>
						<tagsToExclude>com.redislabs.provider.redis.util.BenchmarkTest</tagsToExclude>
						<!-- The plugin does not pass Maven's -D properties to the forked test JVM, so forward them here. -->
						<systemProperties>
							<redis.image>${redis.image}</redis.image>
							<redis.containers>${redis.containers}</redis.containers>
							<golden.update>${golden.update}</golden.update>
						</systemProperties>
					</configuration>
					<executions>
						<execution>
							<id>test</id>
							<goals>
								<goal>test</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
	<dependencyManagement>
		<dependencies>
			<!-- Testcontainers talks to Docker through JNA and is built with JNA 5.13.0. Spark brings an older JNA in
			     the Scala 2.13 builds (5.3.1 with Spark 3.2), which would win and has no Apple Silicon library, so
			     the tests couldn't start Redis on an arm64 Mac. This sets the version only, not the scope. -->
			<dependency>
				<groupId>net.java.dev.jna</groupId>
				<artifactId>jna</artifactId>
				<version>5.13.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<!-- Inherited by every module, which sets spark.version and scala.complete.version. -->
	<dependencies>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>${jedis.version}</version>
            <type>jar</type>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
            <version>${scala.complete.version}</version>
	    <scope>provided</scope>
        </dependency>
		<dependency>
			<groupId>org.scala-lang</groupId>
			<artifactId>scalap</artifactId>
			<version>${scala.complete.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.scala-lang</groupId>
			<artifactId>scala-compiler</artifactId>
			<version>${scala.complete.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-core_${scala.major.version}</artifactId>
            <version>${spark.version}</version>
			<scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_${scala.major.version}</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>
		<dependency>
			<groupId>org.scalatest</groupId>
			<artifactId>scalatest_${scala.major.version}</artifactId>
			<version>3.0.8</version>
			<scope>test</scope>
		</dependency>
		<!-- Runs the Redis servers the test suites need in Docker (src/test/scala/.../env/RedisContainers.scala). -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers</artifactId>
			<version>${testcontainers.version}</version>
			<scope>test</scope>
		</dependency>
    </dependencies>
    <profiles>
		<profile>
			<id>benchmark</id>
			<build>
				<pluginManagement>
					<plugins>
						<plugin>
							<groupId>org.scalatest</groupId>
							<artifactId>scalatest-maven-plugin</artifactId>
							<version>${plugins.scalatest.version}</version>
							<configuration combine.self="override">
								<tagsToInclude>com.redislabs.provider.redis.util.BenchmarkTest</tagsToInclude>
								<!-- This profile replaces the whole plugin configuration, so repeat what the tests need. -->
								<workingDirectory>${redis.root}</workingDirectory>
								<argLine>${spark.test.jvm.options} -Xmx2g ${spark.test.ssl.options}</argLine>
								<systemProperties>
									<redis.image>${redis.image}</redis.image>
									<redis.containers>${redis.containers}</redis.containers>
									<golden.update>${golden.update}</golden.update>
								</systemProperties>
							</configuration>
						</plugin>
					</plugins>
				</pluginManagement>
			</build>
		</profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!--Include sources and docs-->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>2.2.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>2.9.1</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

					<!--Sign the components - this is required by maven central for releases -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.0.1</version>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 'mvn deploy' uploads to Maven Central through the Central Publisher Portal. Sonatype shut down
                         OSSRH (oss.sonatype.org) on 2025-06-30. The 'central' server in settings.xml holds a Portal
                         user token. autoPublish releases the deployment once it passes validation, and waitUntil
                         makes the build fail if it doesn't reach Maven Central. -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <deploymentName>${project.artifactId} ${project.version}</deploymentName>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
