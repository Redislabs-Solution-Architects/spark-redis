<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.redis</groupId>
		<artifactId>spark-redis-parent_2.13</artifactId>
		<version>4.0.0-M1-SNAPSHOT</version>
	</parent>
	<!-- The connector for Spark 4.3: the shared sources in ../src, built and tested against this Spark line. -->
	<artifactId>spark-redis-spark-4.3_2.13</artifactId>
	<name>Spark-Redis for Spark 4.3</name>

	<properties>
		<!-- the overlay ../src/spark-4.3/scala, for code that only compiles against Spark 4.3 -->
		<spark.line>spark-4.3</spark.line>
		<!-- the latest 4.3.x patch, and the Scala version it is built with (<scala.version> in its spark-parent pom) -->
		<spark.version>4.3.0</spark.version>
		<scala.complete.version>2.13.18</scala.complete.version>
	</properties>

	<!-- Configured in the parent's pluginManagement. -->
	<build>
		<plugins>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>net.alchim31.maven</groupId>
				<artifactId>scala-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.scalastyle</groupId>
				<artifactId>scalastyle-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.scalatest</groupId>
				<artifactId>scalatest-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
